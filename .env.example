# Company API key from https://whop.com/dashboard/developer (Developer → Company API keys).
# Only the bank and crypto rails call Whop, and POST /deposits needs no scope — but
# payout:account:update is what lets the first call provision the bank rail.
# Server-side only: it is never sent to the browser.
WHOP_API_KEY=

# The company being funded. It is in your dashboard URL:
# whop.com/dashboard/biz_xxxxxxxxxxxx
WHOP_COMPANY_ID=
